<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>8.0</LangVersion>
        <Nullable>enable</Nullable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <EnableDefaultContentItems>true</EnableDefaultContentItems>
        <MvcRazorCompileOnPublish>true</MvcRazorCompileOnPublish>
        <MvcRazorCompileOnBuild>true</MvcRazorCompileOnBuild>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Hangfire.Atoms contributors</Authors>
        <PackageProjectUrl>https://github.com/ahydrax/Hangfire.Atoms</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/ahydrax/Hangfire.Atoms/blob/master/LICENSE</PackageLicenseUrl>
        <Copyright>Hangfire.Atoms contributors</Copyright>
        <RepositoryUrl>https://github.com/ahydrax/Hangfire.Atoms</RepositoryUrl>
        <PackageTags>hangfire jobs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hangfire.Core" Version="[1.8,1.9)"/>
    </ItemGroup>

    <ItemGroup>
        <RazorSrcFiles Include="Dashboard\Pages\AtomDetailsPage.cshtml"/>
        <RazorSrcFiles Include="Dashboard\Pages\AtomsPage.cshtml"/>
        <RazorSrcFiles Include="Dashboard\Pages\TriggersPage.cshtml"/>
    </ItemGroup>
</Project>
